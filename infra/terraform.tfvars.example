# Copy to terraform.tfvars (gitignored) or export TF_VAR_subscription_id instead.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Classic PAT with only read:packages (github.com/settings/tokens), so Container Apps can pull from GHCR
ghcr_pull_token = "ghp_..."

# Optional overrides
# prefix          = "ddt"
# location        = "swedencentral"
# search_location = "polandcentral"
