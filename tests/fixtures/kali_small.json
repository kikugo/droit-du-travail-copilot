              "data": {"id": "KALIARTI000000000101", "cid": "KALIARTI000000000101", "num": "15", "intOrdre": "10", "etat": "VIGUEUR_ETEN", "content": "<p>Sauf accord entre les parties, la durée du préavis est de :</p><p>- 1 mois pour les employés ;</p><p>- 3 mois pour les cadres.</p>"}
